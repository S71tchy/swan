      "Bash(poetry --version)",
      "Bash(uv sync *)",
      "Bash(uv run *)",
      "Bash(npm install *)",
      "Bash(npx tsc *)",
      "Bash(npm run *)",
      "Bash(echo \"started api, pid $!\")",
