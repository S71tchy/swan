      "Bash(kill 1925)",
      "Bash(pwsh -NoProfile -File start-dev.ps1)",
      "Bash(echo \"launched start-dev.ps1, pid $!\")",
      "Bash(curl -s -o /dev/null -w \"api /health -> %{http_code}\\\\n\" http://127.0.0.1:8000/health)",
      "Bash(curl -s -o /dev/null -w \"web proxy  -> %{http_code}\\\\n\" -X POST http://localhost:5173/api/auth/login -H 'Content-Type: application/json' -d '{}')"
