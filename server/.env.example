# Copy to .env and adjust. Defaults run out-of-the-box on a local SQLite file.
#
# To use PostgreSQL instead (zero code change), point DATABASE_URL at your server:
#   DATABASE_URL=postgresql+psycopg://swan:swan@localhost:5432/swan
# Phase 2 (PostGIS geometry) will add a migration that requires the postgis extension.
DATABASE_URL=sqlite:///./swan.db

# Signs the stubbed-SSO session JWT. Replace in any shared environment.
SECRET_KEY=dev-secret-change-me
SESSION_TTL_HOURS=12

# Frontend origin for CORS (Vite dev server).
FRONTEND_ORIGIN=http://localhost:5173

# --- Email / notification engine (spec §5.6) ---
# Leave SMTP_HOST BLANK to run in dev "console mode": every notification is
# printed to the server console instead of sent, so the whole flow is testable
# without a mail server. Fill these in to deliver real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Display/envelope sender — use an address your relay is authorised to send as.
SMTP_FROM=SWAN Alerts <no-reply@aglgroup.com>
# STARTTLS: true for submission port 587 (Gmail / Microsoft 365 / SES / most relays).
# Set false for a plain local catcher such as aiosmtpd on :1025.
SMTP_STARTTLS=true

# Public base URL of the web app — used to build the deep links inside emails.
APP_BASE_URL=http://localhost:5173
